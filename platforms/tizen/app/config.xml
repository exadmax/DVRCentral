<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://diogo.local/CentralDiogo" version="1.0.0" viewmodes="maximized">
  <tizen:application id="CentralDg0.App" package="CentralDg0" required_version="5.0"/>
  <content src="index.html"/>
  <icon src="icon.png"/>
  <name>Central Diogo</name>
  <!-- Permite falar com o hub de casa (HTTP na rede local) -->
  <access origin="*" subdomains="true"/>
  <tizen:allow-navigation>192.168.0.10</tizen:allow-navigation>
  <tizen:privilege name="http://tizen.org/privilege/internet"/>
  <tizen:privilege name="http://tizen.org/privilege/power"/>
  <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable" encryption="disable" install-location="auto"/>
</widget>
